#version 460
// Camera motion vectors for the DLSS path, from the render-resolution depth: where the surface seen by a pixel was in the previous frame, in pixels
// of the render image (previous position minus current position, the convention of DLSS with mvecScale = 1 / size). Only the camera moves here;
// objects are static between frames (an edited brush resets the history instead, see render_thread.cpp).
// The depth was drawn with the jittered projection, so the world point comes from the inverse of the jittered matrix; the current position is
// then the pixel centre minus the jitter (the same point seen without jitter), and the previous one comes from the previous unjittered matrix.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uDepth;                       // D32, render size, depth-read-only layout
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D uMvec;         // render size

layout(push_constant) uniform PC {
    mat4 reproject;   // previous unjittered view-projection * inverse(current jittered view-projection)
    vec4 info;        // x, y = render size in pixels, z, w = the frame's jitter in pixels
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.info.x) || p.y >= int(pc.info.y)) return;
    float d = texelFetch(uDepth, p, 0).r;
    vec2 centre = vec2(p) + 0.5;
    vec2 ndc = centre / pc.info.xy * 2.0 - 1.0;
    vec4 prev = pc.reproject * vec4(ndc, d, 1.0);
    vec2 prevPx = (prev.xy / prev.w * 0.5 + 0.5) * pc.info.xy;
    vec2 curPx = centre - pc.info.zw;
    imageStore(uMvec, p, vec4(prevPx - curPx, 0.0, 0.0));
}
