#version 460
// R2: the occlusion signal of the ray traced Lit path. One invocation per pixel of the render image: the history of the previous frame is reprojected onto the
// pixel (4 taps, each checked against the pixel's distance and normal), one cosine-weighted ray estimates the occlusion exactly as the bake does (core/lights.h:
// a hit within the radius weighs (1 - d / radius)^falloff, the occlusion is the mean of the weights), and the running mean is updated. A pixel that already holds
// the target number of samples under a still camera is not traced (the converged stop).
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 8, local_size_y = 8) in;

#include "rt_lit_common.glsl"

layout(set = 1, binding = 0) uniform accelerationStructureEXT tlas;

const float PI = 3.14159265358979323846;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand01(inout uint seed) {
    seed = pcg(seed);
    return float(seed >> 8u) * (1.0 / 16777216.0);
}

// What the previous frame knew about the surface point seen here: (mean, mean of the square, N, distance) or N = 0.
vec4 reprojected(ivec2 p, vec3 world, vec3 n, float dist, bool still, bool reset) {
    ivec2 sz = ivec2(P.size.xy);
    if (reset) return vec4(0.0);
    if (still) return imageLoad(uHistPrev, p);
    vec4 pc = P.prevViewProj * vec4(world, 1.0);
    if (pc.w <= 1e-4) return vec4(0.0);
    vec2 px = (pc.xy / pc.w * 0.5 + 0.5) * P.size.xy - 0.5;
    ivec2 base = ivec2(floor(px));
    vec2 f = px - vec2(base);
    vec4 sum = vec4(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 q = base + ivec2(i & 1, i >> 1);
        if (q.x < 0 || q.y < 0 || q.x >= sz.x || q.y >= sz.y) continue;
        vec4 nq = texelFetch(uNormalPrev, q, 0);
        if (nq.w < 0.5 || dot(nq.xyz, n) < 0.8) continue;   // the normal is the stored one, not flipped to the viewer: compare the planes' orientation
        vec4 h = imageLoad(uHistPrev, q);
        if (h.b < 0.5 || abs(h.a - pc.w) > 0.03 * pc.w + 1e-3) continue;
        float w = ((i & 1) != 0 ? f.x : 1.0 - f.x) * ((i >> 1) != 0 ? f.y : 1.0 - f.y);
        sum += w * h;
        wsum += w;
    }
    if (wsum < 1e-3) return vec4(0.0);
    return sum / wsum;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = ivec2(P.size.xy);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec4 nrm = texelFetch(uNormal, p, 0);
    if (nrm.w < 0.5) {
        imageStore(uHist, p, vec4(0.0));
        imageStore(uSample, p, vec4(0.0));
        return;
    }
    float dist = texelFetch(uDist, p, 0).r;
    vec3 world = worldOf(p, dist);
    vec3 nGeo = normalize(nrm.xyz);
    vec3 n = dot(nGeo, world - P.eye.xyz) > 0.0 ? -nGeo : nGeo;   // lit from the side the viewer sees
    bool still = (P.u.y & F_STILL) != 0u, reset = (P.u.y & F_RESET) != 0u;

    vec4 h = reprojected(p, world, nGeo, dist, still, reset);
    float count = h.b;
    if (!still) count = min(count, P.mode.y);
    float mean = h.r, m2 = h.g;
    float x = mean;

    bool done = still && count >= float(P.u.w);
    uint tracedNow = 0u;
    if (!done) {
        uint seed = pcg(uint(p.x) + pcg(uint(p.y) + pcg(P.u.x)));
        float u1 = rand01(seed), u2 = rand01(seed);
        vec3 helper = abs(n.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
        vec3 tu = normalize(cross(n, helper)), tv = cross(n, tu);
        float r = sqrt(u1), phi = 2.0 * PI * u2;
        vec3 dir = normalize(tu * (r * cos(phi)) + tv * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
        x = 0.0;
        if (P.ambient.w > 0.5 && P.ao.x > 0.0) {
            rayQueryEXT rq;
            rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, world + n * P.ao2.y, 0.0, dir, P.ao.x);
            while (rayQueryProceedEXT(rq)) {}
            if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                float d = rayQueryGetIntersectionTEXT(rq, true);
                if (d < P.ao.x) x = P.ao2.x == 1.0 ? 1.0 - d / P.ao.x : pow(1.0 - d / P.ao.x, P.ao2.x);
            }
        }
        float c = min(count + 1.0, float(P.u.z));
        mean += (x - mean) / c;
        m2 += (x * x - m2) / c;
        count = c;
        tracedNow = 1u;
    }
    imageStore(uHist, p, vec4(mean, m2, count, dist));
    imageStore(uSample, p, vec4(x, 0.0, 0.0, 0.0));
    uint t = subgroupAdd(tracedNow);
    if (subgroupElect() && t != 0u) atomicAdd(counters.traced, t);
}
