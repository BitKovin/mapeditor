#version 460
// R2: the occlusion signal of the ray traced Lit path. One invocation per pixel of the render image: the history of the previous frame is reprojected onto the
// pixel (4 taps, each checked against the pixel's distance and normal), one cosine-weighted ray estimates the occlusion exactly as the bake does (core/lights.h:
// a hit within the radius weighs (1 - d / radius)^falloff, the occlusion is the mean of the weights), and the running mean is updated. A pixel that already holds
// the target number of samples under a still camera is not traced (the converged stop).
// R3: the same pixel also gets one sample of the direct light (rt_light.glsl) with its own running mean; both means share the sample count N. With the lightmap look
// (P.look.x > 0) the shading point is not the pixel's surface point but the centre of one of the four lightmap texels around it (a planar texel grid of P.look.x texels per
// metre, the texel chosen with the bilinear weights, so the converged mean is the bilinearly filtered lightmap value the game shows).
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_control_flow_attributes : require

#define SHARC_ENABLE_GLSL 1
#define SHARC_UPDATE 0

layout(local_size_x = 8, local_size_y = 8) in;

#include "rt_lit_common.glsl"

layout(set = 1, binding = 0) uniform accelerationStructureEXT tlas;

const float PI = 3.14159265358979323846;

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float rand01(inout uint seed) {
    seed = pcg(seed);
    return float(seed >> 8u) * (1.0 / 16777216.0);
}

#include "rt_light.glsl"
#include "rt_gi.glsl"
#include "rt_sharc_common.glsl"

// What the previous frame knew about the surface point seen here: h = (mean, mean of the square, N, distance) or N = 0; hd = the direct light's (mean rgb, mean of luminance^2).
void reprojected(ivec2 p, vec3 world, vec3 n, float dist, bool still, bool reset, out vec4 h, out vec4 hd, out vec3 hs[3]) {
    ivec2 sz = ivec2(P.size.xy);
    h = vec4(0.0);
    hd = vec4(0.0);
    for (uint l = 0u; l < 3u; ++l) hs[l] = vec3(0.0);
    uint styled = min(P.layerInfo.x, 4u) - 1u;
    if (reset) return;
    if (still) {
        h = imageLoad(uHistPrev, p);
        hd = imageLoad(uHistDPrev, p);
        for (uint l = 0u; l < styled; ++l) hs[l] = loadStyledPrev(l, p);
        return;
    }
    vec4 pc = P.prevViewProj * vec4(world, 1.0);
    if (pc.w <= 1e-4) return;
    vec2 px = (pc.xy / pc.w * 0.5 + 0.5) * P.size.xy - 0.5;
    ivec2 base = ivec2(floor(px));
    vec2 f = px - vec2(base);
    vec4 sum = vec4(0.0), sumD = vec4(0.0);
    vec3 sumS[3] = vec3[3](vec3(0.0), vec3(0.0), vec3(0.0));
    float wsum = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 q = base + ivec2(i & 1, i >> 1);
        if (q.x < 0 || q.y < 0 || q.x >= sz.x || q.y >= sz.y) continue;
        vec4 nq = texelFetch(uNormalPrev, q, 0);
        if (nq.w < 0.5 || dot(nq.xyz, n) < 0.8) continue;   // the normal is the stored one, not flipped to the viewer: compare the planes' orientation
        vec4 hq = imageLoad(uHistPrev, q);
        if (hq.b < 0.5 || abs(hq.a - pc.w) > 0.03 * pc.w + 1e-3) continue;
        float w = ((i & 1) != 0 ? f.x : 1.0 - f.x) * ((i >> 1) != 0 ? f.y : 1.0 - f.y);
        sum += w * hq;
        sumD += w * imageLoad(uHistDPrev, q);
        for (uint l = 0u; l < styled; ++l) sumS[l] += w * loadStyledPrev(l, q);
        wsum += w;
    }
    if (wsum < 1e-3) return;
    h = sum / wsum;
    hd = sumD / wsum;
    for (uint l = 0u; l < styled; ++l) hs[l] = sumS[l] / wsum;
}

// The lightmap look: the centre of one of the four texels of a planar grid around `world` (the grid of the dominant axis of the normal, P.look.x texels per metre), picked
// with the bilinear weights, on the plane of the surface.
vec3 lightmapTexelCentre(vec3 world, vec3 nGeo, inout uint seed) {
    vec3 an = abs(nGeo);
    int axis = an.x >= an.y && an.x >= an.z ? 0 : (an.y >= an.z ? 1 : 2);
    int ua = axis == 0 ? 1 : 0, va = axis == 2 ? 1 : 2;
    float d = P.look.x;
    vec2 q = vec2(world[ua], world[va]) * d - 0.5;
    vec2 base = floor(q), f = q - base;
    float r1 = rand01(seed), r2 = rand01(seed);
    vec2 centre = (base + vec2(f.x > r1 ? 1.0 : 0.0, f.y > r2 ? 1.0 : 0.0) + 0.5) / d;
    vec3 c = world;
    c[ua] = centre.x;
    c[va] = centre.y;
    c[axis] = world[axis] - (nGeo[ua] * (centre.x - world[ua]) + nGeo[va] * (centre.y - world[va])) / nGeo[axis];
    return c;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = ivec2(P.size.xy);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec4 nrm = texelFetch(uNormal, p, 0);
    if (nrm.w < 0.8) {   // no surface, or a surface of a class that does not receive baked light (shown unlit by the compose pass): nothing is traced
        imageStore(uHist, p, vec4(0.0));
        imageStore(uHistD, p, vec4(0.0));
        for (uint l = 0u; l < min(P.layerInfo.x, 4u) - 1u; ++l) storeStyled(l, p, vec3(0.0));
        imageStore(uSample, p, vec4(0.0));
        imageStore(uSampleD, p, vec4(0.0));
        return;
    }
    float dist = texelFetch(uDist, p, 0).r;
    vec3 world = worldOf(p, dist);
    vec3 nGeo = normalize(nrm.xyz);
    vec3 n = dot(nGeo, world - P.eye.xyz) > 0.0 ? -nGeo : nGeo;   // lit from the side the viewer sees
    bool still = (P.u.y & F_STILL) != 0u, reset = (P.u.y & F_RESET) != 0u;

    vec4 h, hd;
    vec3 sMean[3];
    reprojected(p, world, nGeo, dist, still, reset, h, hd, sMean);
    uint styled = min(P.layerInfo.x, 4u) - 1u;
    vec3 sx[3] = vec3[3](vec3(0.0), vec3(0.0), vec3(0.0));
    float count = h.b;
    if (!still) count = min(count, P.mode.y);
    float mean = h.r, m2 = h.g;
    float x = mean;
    vec3 dMean = hd.rgb, dx = hd.rgb;
    float dM2 = hd.a;

    bool done = still && count >= float(P.u.w);
    uint tracedNow = 0u;
    if (!done) {
        uint seed = pcg(uint(p.x) + pcg(uint(p.y) + pcg(P.u.x)));
        vec3 ps = world;
        if (P.look.x > 0.0) ps = lightmapTexelCentre(world, nGeo, seed);
        float u1 = rand01(seed), u2 = rand01(seed);
        vec3 helper = abs(n.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
        vec3 tu = normalize(cross(n, helper)), tv = cross(n, tu);
        float r = sqrt(u1), phi = 2.0 * PI * u2;
        vec3 dir = normalize(tu * (r * cos(phi)) + tv * (r * sin(phi)) + n * sqrt(max(0.0, 1.0 - u1)));
        x = 0.0;
        vec3 gi = vec3(0.0);
        bool needAo = P.ambient.w > 0.5 && P.ao.x > 0.0, needGi = P.gi.z > 0.5;
        if (needAo || needGi) {   // one cosine ray serves both: the occlusion by its length, the bounce light by what it hits (the bake's gather)
            rayQueryEXT rq;
            rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, RT_MASK_SOLID, ps + n * P.ao2.y, 0.0, dir, needGi ? max(P.gi.y, P.ao.x) : P.ao.x);
            while (rayQueryProceedEXT(rq)) {}
            if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
                float d = rayQueryGetIntersectionTEXT(rq, true);
                if (needAo && d < P.ao.x) x = P.ao2.x == 1.0 ? 1.0 - d / P.ao.x : pow(1.0 - d / P.ao.x, P.ao2.x);
                if (needGi && d < P.gi.y) {
                    GiHit h = giHitOf(rq, dir);
                    if (h.valid) {
                        SharcHitData hd;
                        hd.positionWorld = h.pos;
                        hd.normalWorld = h.n;
                        vec3 s;
                        if (SharcGetCachedRadiance(sharcParameters(), hd, s, false)) gi = s * h.albedo * (P.gi.x * window(h.t, P.gi.y));
                    }
                }
            }
        }
        dx = directSample(ps, n, seed) + gi;
        for (uint l = 0u; l < styled; ++l) sx[l] = directSampleL(ps, n, seed, false, l + 1u);
        float c = min(count + 1.0, float(P.u.z));
        for (uint l = 0u; l < styled; ++l) sMean[l] += (sx[l] - sMean[l]) / c;
        mean += (x - mean) / c;
        m2 += (x * x - m2) / c;
        dMean += (dx - dMean) / c;
        float dl = lum(dx);
        dM2 += (dl * dl - dM2) / c;
        count = c;
        tracedNow = 1u;
    }
    // the frame's sample of the styled layers when it was traced, else their means: weighted with the style values of this frame
    vec3 dxTotal = dx;
    for (uint l = 0u; l < styled; ++l) {
        storeStyled(l, p, sMean[l]);
        dxTotal += P.styleW[l + 1u] * (tracedNow != 0u ? sx[l] : sMean[l]);
    }
    imageStore(uHist, p, vec4(mean, m2, count, dist));
    imageStore(uHistD, p, vec4(dMean, dM2));
    imageStore(uSample, p, vec4(x, 0.0, 0.0, 0.0));
    imageStore(uSampleD, p, vec4(dxTotal, 0.0));
    uint t = subgroupAdd(tracedNow);
    if (subgroupElect() && t != 0u) atomicAdd(counters.traced, t);
}
