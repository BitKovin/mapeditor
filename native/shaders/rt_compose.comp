#version 460
// R2/R3: the shown colour of the ray traced Lit path (12 §2): clamp(albedo * L * exposure + brightness) with L = max(0, (ambient + D) * aoFactor(o)) in Lit (D = the direct
// light: sun, sky and local lights, the same blend rules as `o`),
// clamp(L * exposure + brightness) in Lighting only. `o` is the running mean of the occlusion, replaced near the start of a history by the filtered signal
// (blend 1 - min(1, N / mode.z)); aoFactor is applied to that estimate, never to a single sample (it is not linear). For DLSS Ray Reconstruction (flag 8) the
// input is the single sample of this frame, replaced by the running mean once the camera has been still for mode.w samples, so a still view hands RR its
// converged picture. Pixels without a surface show the albedo target (the sky / the background clear colour).
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 8, local_size_y = 8) in;

#include "rt_lit_common.glsl"

layout(push_constant) uniform PC {
    uint finalFil;   // 0: the last filter iteration wrote uFil0, 1: uFil1
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = ivec2(P.size.xy);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec4 albedo = texelFetch(uAlbedo, p, 0);
    uint s = subgroupAdd(hasSurface(p) ? 1u : 0u);
    if (subgroupElect() && s != 0u) atomicAdd(counters.surface, s);
    if (!hasSurface(p)) {
        imageStore(uOut, p, vec4(albedo.rgb, 1.0));
        return;
    }
    if (abs(texelFetch(uNormal, p, 0).w - 0.7) < 0.05) {   // lit from the light volume (T10.1): the G-buffer pass wrote the finished colour, exposure and brightness included
        imageStore(uOut, p, vec4(albedo.rgb, 1.0));
        return;
    }
    if (!receivesLight(p)) {   // the look the chunked Lit mode gives a surface without a lightmap (mesh.frag)
        vec3 nn = normalize(texelFetch(uNormal, p, 0).xyz);
        float sh = 0.7 + 0.3 * abs(dot(nn, normalize(vec3(0.35, 0.85, 0.4))));
        imageStore(uOut, p, vec4(clamp((P.mode.x > 1.5 ? vec3(0.35) : albedo.rgb * 0.6) * sh, 0.0, 1.0), 1.0));
        return;
    }
    vec4 h = imageLoad(uHist, p);
    float o = h.r;
    vec3 D = imageLoad(uHistD, p).rgb;
    vec3 Ds = vec3(0.0);   // the styled layers' running means weighted with this frame's style values
    for (uint l = 0u; l < min(P.layerInfo.x, 4u) - 1u; ++l) Ds += P.styleW[l + 1u] * loadStyledCur(l, p);
    if ((P.u.y & F_RR) != 0u) {
        float x = imageLoad(uSample, p).r;
        vec3 dx = imageLoad(uSampleD, p).rgb;
        bool still = (P.u.y & F_STILL) != 0u;
        float b = min(1.0, h.b / P.mode.w);
        o = still ? mix(x, h.r, b) : x;
        D = still ? mix(dx, D + Ds, b) : dx;
    } else if ((P.u.y & F_FILTER) != 0u) {
        float f = pc.finalFil == 0u ? imageLoad(uFil0, p).r : imageLoad(uFil1, p).r;
        vec3 fd = pc.finalFil == 0u ? imageLoad(uFilD0, p).rgb : imageLoad(uFilD1, p).rgb;
        float b = min(1.0, h.b / P.mode.z);
        o = mix(f, h.r, b);
        D = mix(fd, D, b) + Ds;
    } else {
        D += Ds;
    }
    vec3 L = max(vec3(0.0), (P.ambient.rgb + D) * aoFactor(o));
    vec3 base = P.mode.x > 1.5 ? vec3(1.0) : albedo.rgb;
    imageStore(uOut, p, vec4(clamp(base * L * P.ao2.z + P.ao2.w, 0.0, 1.0), 1.0));
}
