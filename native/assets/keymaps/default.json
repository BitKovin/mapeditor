{
  "name": "default",
  "bindings": [
    { "action": "file.new",     "context": "global", "input": "Ctrl+N" },
    { "action": "file.open",    "context": "global", "input": "Ctrl+O" },
    { "action": "file.save",    "context": "global", "input": "Ctrl+S" },
    { "action": "file.save_as", "context": "global", "input": "Ctrl+Shift+S" },
    { "action": "file.settings", "context": "global", "input": "Ctrl+," },
    { "action": "file.play",   "context": "global", "input": "F5" },
    { "action": "file.exit",    "context": "global", "input": "Ctrl+Q" },
    { "action": "view.command_palette", "context": "global", "input": "F3" },
    { "action": "view.command_palette", "context": "global", "input": "Ctrl+Shift+P" },
    { "action": "help.keys", "context": "global", "input": "Hold F1" },
    { "action": "edit.undo",   "context": "global", "input": "Ctrl+Z" },
    { "action": "edit.redo",   "context": "global", "input": "Ctrl+Shift+Z" },
    { "action": "edit.redo",   "context": "global", "input": "Ctrl+Y" },

    { "action": "select.pick", "context": "tool:select", "input": "LMB drag" },
    { "action": "select.pick", "context": "tool:select", "input": "Ctrl+LMB drag", "params": { "op": "toggle" } },
    { "action": "select.pick", "context": "tool:select", "input": "Shift+LMB drag", "params": { "op": "face" } },

    { "action": "edit.delete",    "context": "area:viewport", "input": "Delete" },
    { "action": "edit.delete",    "context": "area:viewport", "input": "Backspace" },
    { "action": "edit.duplicate", "context": "area:viewport", "input": "Ctrl+D" },
    { "action": "edit.copy",      "context": "area:viewport", "input": "Ctrl+C" },
    { "action": "edit.cut",       "context": "area:viewport", "input": "Ctrl+X" },
    { "action": "edit.paste",     "context": "area:viewport", "input": "Ctrl+V" },
    { "action": "edit.group",     "context": "area:viewport", "input": "Ctrl+G" },
    { "action": "edit.ungroup",   "context": "area:viewport", "input": "Ctrl+Shift+G" },
    { "action": "edit.hide",      "context": "area:viewport", "input": "H" },
    { "action": "edit.unhide_all", "context": "area:viewport", "input": "Alt+H" },

    { "action": "grid.smaller", "context": "area:viewport", "input": "[" },
    { "action": "grid.larger",  "context": "area:viewport", "input": "]" },

    { "action": "tool.set",   "context": "area:viewport", "input": "V", "params": { "tool": "select" } },
    { "action": "shape.set",  "context": "area:viewport", "input": "B", "params": { "shape": "box" } },
    { "action": "shape.turn", "context": "tool:box",      "input": "T" },
    { "action": "box.draw",   "context": "tool:box",      "input": "LMB drag" },
    { "action": "box.draw",   "context": "tool:box",      "input": "Shift+LMB drag" },
    { "action": "box.cancel", "context": "tool:box",      "input": "Escape" },

    { "action": "mesh.toggle",  "context": "area:viewport", "input": "Tab" },
    { "action": "mesh.element", "context": "mode:mesh", "input": "1", "params": { "element": "vertex" } },
    { "action": "mesh.element", "context": "mode:mesh", "input": "2", "params": { "element": "edge" } },
    { "action": "mesh.element", "context": "mode:mesh", "input": "3", "params": { "element": "face" } },
    { "action": "mesh.pick", "context": "mode:mesh", "input": "LMB drag" },
    { "action": "mesh.pick", "context": "mode:mesh", "input": "Shift+LMB drag" },
    { "action": "mesh.pick", "context": "mode:mesh", "input": "Ctrl+LMB drag" },
    { "action": "mesh.pick", "context": "mode:mesh", "input": "Alt+LMB drag" },
    { "action": "mesh.pick", "context": "mode:mesh", "input": "Ctrl+Alt+LMB drag" },
    { "action": "mesh.connect",   "context": "mode:mesh", "input": "J" },
    { "action": "mesh.merge",     "context": "mode:mesh", "input": "M" },
    { "action": "mesh.fill",      "context": "mode:mesh", "input": "F" },
    { "action": "mesh.dissolve",  "context": "mode:mesh", "input": "X" },
    { "action": "mesh.delete",    "context": "mode:mesh", "input": "Delete" },
    { "action": "mesh.delete",    "context": "mode:mesh", "input": "Backspace" },
    { "action": "mesh.flip",      "context": "mode:mesh", "input": "Alt+N" },
    { "action": "mesh.recalc",    "context": "mode:mesh", "input": "Shift+N" },
    { "action": "mesh.select_all",    "context": "mode:mesh", "input": "A" },
    { "action": "mesh.select_none",   "context": "mode:mesh", "input": "Alt+A" },
    { "action": "mesh.select_invert", "context": "mode:mesh", "input": "Ctrl+I" },
    { "action": "mesh.select_grow",   "context": "mode:mesh", "input": "=" },
    { "action": "mesh.select_shrink", "context": "mode:mesh", "input": "-" },

    { "action": "transform.grab",   "context": "area:viewport", "input": "G" },
    { "action": "transform.rotate", "context": "area:viewport", "input": "R" },
    { "action": "transform.scale",  "context": "area:viewport", "input": "S" },
    { "action": "transform.leave_origin", "context": "area:viewport", "input": "Escape" },
    { "action": "transform.confirm", "context": "modal:transform", "input": "LMB" },
    { "action": "transform.confirm", "context": "modal:transform", "input": "Enter" },
    { "action": "transform.confirm", "context": "modal:transform", "input": "Numpad Enter" },
    { "action": "transform.cancel",  "context": "modal:transform", "input": "RMB" },
    { "action": "transform.cancel",  "context": "modal:transform", "input": "Escape" },
    { "action": "transform.axis",    "context": "modal:transform", "input": "X", "params": { "axis": 0 } },
    { "action": "transform.axis",    "context": "modal:transform", "input": "Y", "params": { "axis": 1 } },
    { "action": "transform.axis",    "context": "modal:transform", "input": "Z", "params": { "axis": 2 } },

    { "action": "camera.mode", "context": "area:viewport", "input": "Numpad 0", "params": { "mode": "fly" } },
    { "action": "camera.mode", "context": "area:viewport", "input": "Numpad 5", "params": { "mode": "orbit" } },
    { "action": "camera.mode", "context": "area:viewport", "input": "Numpad 7", "params": { "mode": "top" } },
    { "action": "camera.mode", "context": "area:viewport", "input": "Numpad 1", "params": { "mode": "front" } },
    { "action": "camera.mode", "context": "area:viewport", "input": "Numpad 3", "params": { "mode": "side" } },
    { "action": "gizmo.mode",  "context": "area:viewport", "input": "W",       "params": { "mode": "move" } },
    { "action": "gizmo.mode",  "context": "area:viewport", "input": "E",       "params": { "mode": "rotate" } },
    { "action": "gizmo.mode",  "context": "area:viewport", "input": "Shift+W", "params": { "mode": "scale" } },
    { "action": "view.layout", "context": "global",        "input": "Ctrl+1",  "params": { "count": 1 } },
    { "action": "view.layout", "context": "global",        "input": "Ctrl+2",  "params": { "count": 2 } },
    { "action": "view.layout", "context": "global",        "input": "Ctrl+4",  "params": { "count": 4 } },

    { "action": "camera.look",  "context": "view:fly",      "input": "RMB drag" },
    { "action": "camera.orbit", "context": "view:orbit",    "input": "RMB drag" },
    { "action": "camera.pan2d", "context": "view:ortho",    "input": "RMB drag" },
    { "action": "camera.pan",   "context": "area:viewport", "input": "MMB drag" },
    { "action": "camera.dolly", "context": "area:viewport", "input": "Wheel" },

    { "action": "camera.fly.speed",    "context": "hold:camera.fly", "input": "Wheel" },
    { "action": "camera.fly.forward",  "context": "hold:camera.fly", "input": "Hold phys:W", "ignoreShift": true },
    { "action": "camera.fly.back",     "context": "hold:camera.fly", "input": "Hold phys:S", "ignoreShift": true },
    { "action": "camera.fly.left",     "context": "hold:camera.fly", "input": "Hold phys:A", "ignoreShift": true },
    { "action": "camera.fly.right",    "context": "hold:camera.fly", "input": "Hold phys:D", "ignoreShift": true },
    { "action": "camera.fly.up",       "context": "hold:camera.fly", "input": "Hold phys:E", "ignoreShift": true },
    { "action": "camera.fly.down",     "context": "hold:camera.fly", "input": "Hold phys:Q", "ignoreShift": true },
    { "action": "camera.fly.boost",    "context": "hold:camera.fly", "input": "Hold Shift" }
  ]
}
