{
  "name": "default",
  "bindings": [
    { "action": "file.open",    "context": "global", "input": "Ctrl+O" },
    { "action": "file.save",    "context": "global", "input": "Ctrl+S" },
    { "action": "file.save_as", "context": "global", "input": "Ctrl+Shift+S" },
    { "action": "file.exit",    "context": "global", "input": "Ctrl+Q" },
    { "action": "edit.undo",   "context": "global", "input": "Ctrl+Z" },
    { "action": "edit.redo",   "context": "global", "input": "Ctrl+Shift+Z" },
    { "action": "edit.redo",   "context": "global", "input": "Ctrl+Y" },

    { "action": "select.pick", "context": "tool:select", "input": "LMB drag" },
    { "action": "select.pick", "context": "tool:select", "input": "Ctrl+LMB drag", "params": { "op": "toggle" } },
    { "action": "select.pick", "context": "tool:select", "input": "Shift+LMB drag", "params": { "op": "face" } },

    { "action": "grid.smaller", "context": "area:viewport", "input": "[" },
    { "action": "grid.larger",  "context": "area:viewport", "input": "]" },

    { "action": "tool.set",   "context": "area:viewport", "input": "V", "params": { "tool": "select" } },
    { "action": "shape.set",  "context": "area:viewport", "input": "B", "params": { "shape": "box" } },
    { "action": "shape.turn", "context": "tool:box",      "input": "T" },
    { "action": "box.draw",   "context": "tool:box",      "input": "LMB drag" },
    { "action": "box.draw",   "context": "tool:box",      "input": "Shift+LMB drag" },
    { "action": "box.cancel", "context": "tool:box",      "input": "Escape" },

    { "action": "transform.grab",   "context": "area:viewport", "input": "G" },
    { "action": "transform.rotate", "context": "area:viewport", "input": "R" },
    { "action": "transform.scale",  "context": "area:viewport", "input": "S" },
    { "action": "transform.leave_origin", "context": "area:viewport", "input": "Escape" },
    { "action": "transform.confirm", "context": "modal:transform", "input": "LMB" },
    { "action": "transform.confirm", "context": "modal:transform", "input": "Enter" },
    { "action": "transform.confirm", "context": "modal:transform", "input": "Numpad Enter" },
    { "action": "transform.cancel",  "context": "modal:transform", "input": "RMB" },
    { "action": "transform.cancel",  "context": "modal:transform", "input": "Escape" },
    { "action": "transform.axis",    "context": "modal:transform", "input": "X", "params": { "axis": 0 } },
    { "action": "transform.axis",    "context": "modal:transform", "input": "Y", "params": { "axis": 1 } },
    { "action": "transform.axis",    "context": "modal:transform", "input": "Z", "params": { "axis": 2 } },

    { "action": "camera.look",  "context": "view:fly",      "input": "RMB drag" },
    { "action": "camera.orbit", "context": "view:orbit",    "input": "RMB drag" },
    { "action": "camera.pan2d", "context": "view:ortho",    "input": "RMB drag" },
    { "action": "camera.pan",   "context": "area:viewport", "input": "MMB drag" },
    { "action": "camera.dolly", "context": "area:viewport", "input": "Wheel" },

    { "action": "camera.fly.speed",    "context": "hold:camera.fly", "input": "Wheel" },
    { "action": "camera.fly.forward",  "context": "hold:camera.fly", "input": "Hold phys:W", "ignoreShift": true },
    { "action": "camera.fly.back",     "context": "hold:camera.fly", "input": "Hold phys:S", "ignoreShift": true },
    { "action": "camera.fly.left",     "context": "hold:camera.fly", "input": "Hold phys:A", "ignoreShift": true },
    { "action": "camera.fly.right",    "context": "hold:camera.fly", "input": "Hold phys:D", "ignoreShift": true },
    { "action": "camera.fly.up",       "context": "hold:camera.fly", "input": "Hold phys:E", "ignoreShift": true },
    { "action": "camera.fly.down",     "context": "hold:camera.fly", "input": "Hold phys:Q", "ignoreShift": true },
    { "action": "camera.fly.boost",    "context": "hold:camera.fly", "input": "Hold Shift" }
  ]
}
