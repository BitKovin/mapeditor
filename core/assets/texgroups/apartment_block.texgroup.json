{
  "format": 1,
  "name": "Apartment block",
  "description": "Ground floor with a door and shop fronts, repeating floors with window bays, balconies and a stair window, a special top floor and a cornice. Roofs and floors take their own texture through 'facing'. Built on the demo textures; swap the slots for your own.",
  "params": {
    "floorHeight": { "type": "number", "default": 3, "min": 2, "max": 6, "step": 0.1, "label": "Floor height (m)" },
    "bayWidth": { "type": "number", "default": 3, "min": 2, "max": 8, "step": 0.1, "label": "Bay width (m)" },
    "balconies": { "type": "bool", "default": true, "label": "Balconies" }
  },
  "slots": {
    "wall": "dev/wall",
    "window": "dev/metal",
    "door": "dev/wood",
    "shop": "dev/concrete",
    "stair": "dev/grey",
    "balcony": "dev/floor",
    "cornice": "dev/concrete",
    "roof": "dev/floor"
  },
  "fallback": "wall",
  "rules": {
    "plainBay": { "tex": "wall" },
    "windowBay": {
      "split": "u",
      "parts": [
        { "size": "*", "tex": "wall" },
        { "size": 1.2, "tex": "window", "fit": "stretch" },
        { "size": "*", "tex": "wall" }
      ]
    },
    "balconyBay": {
      "split": "v",
      "parts": [
        { "size": 0.9, "tex": "balcony", "fit": "stretch" },
        { "size": "*", "ref": "windowBay" }
      ]
    },
    "groundFloor": {
      "split": "u",
      "parts": [
        {
          "size": "*",
          "repeat": { "size": { "param": "bayWidth" }, "as": "bay" },
          "choice": [
            { "when": { "all": ["bay.first", { "var": "faceW", ">=": 6 }] }, "tex": "door", "fit": "stretch" },
            { "tex": "shop", "fit": "stretch" }
          ]
        }
      ]
    },
    "floor": {
      "split": "u",
      "parts": [
        {
          "size": "*",
          "repeat": { "size": { "param": "bayWidth" }, "as": "bay" },
          "choice": [
            { "when": "bay.last", "tex": "stair", "fit": "stretch" },
            { "when": { "all": [{ "var": "param.balconies", "==": true }, { "var": "floor.index", "mod": [3, 1] }, { "var": "bay.index", "mod": [2, 0] }] }, "ref": "balconyBay" },
            { "ref": "windowBay" }
          ]
        }
      ]
    },
    "topFloor": {
      "split": "u",
      "parts": [
        {
          "size": "*",
          "repeat": { "size": { "param": "bayWidth" }, "as": "bay" },
          "choice": [{ "ref": "windowBay", "weight": 3 }, { "ref": "plainBay", "weight": 1 }],
          "mode": "random"
        }
      ]
    }
  },
  "root": {
    "choice": [
      {
        "when": { "var": "facing", "==": "wall" },
        "split": "v",
        "parts": [
          { "size": { "param": "floorHeight", "mul": 1.3 }, "ref": "groundFloor" },
          { "size": "*", "repeat": { "size": { "param": "floorHeight" }, "as": "floor" }, "ref": "floor" },
          { "size": { "param": "floorHeight" }, "ref": "topFloor", "optional": true },
          { "size": 0.5, "tex": "cornice", "fit": "width" }
        ]
      },
      { "when": { "var": "facing", "==": "up" }, "tex": "roof" },
      { "tex": "wall" }
    ]
  }
}
